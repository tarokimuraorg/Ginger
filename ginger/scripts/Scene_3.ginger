// Purpose:
// DivideByZero の resolve と回復値 widening
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_builtin_bridge.py::test_resolve_preserves_builtin_event_history
// tests/test_execution_result.py::test_resolved_and_caused_by
// tests/test_failure_contract.py::test_samples_outputs_and_warnings
// tests/test_resolve.py::test_handler_can_recover_with_existing_var_widening
// tests/test_resolve.py::test_partial_resolve_leaves_only_other_initializer_warning
// tests/test_unary_minus.py::test_all_sample_baselines
// tests/test_unary_minus.py::test_inner_failure_warning_resolve_and_runtime
// Expected stdout (ordered):
// -1
// 0.0
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {FloatOverflow} x 1
// Expected normal failure:
// DivideByZero: resolved x 1
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

var x: Float = div(1.0, 0.0)
resolve x {
    DivideByZero {
        x = 0
    }
}
print(neg(1))
print(x)
