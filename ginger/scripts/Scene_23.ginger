// Purpose:
// Int/Int64 対称境界・neg・比較・leading zero
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_bounded_integers.py::test_capabilities
// tests/test_bounded_integers.py::test_literals
// tests/test_bounded_integers.py::test_syntax
// tests/test_integer_overflow.py::test_negation_has_no_overflow_effect
// Expected stdout (ordered):
// -9007199254740991
// 9007199254740991
// -9223372036854775807
// 9223372036854775807
// 1
// false
// true
// Right
// Flat
// Left
// Expected warnings (static diagnostic count; braces are one diagnostic):
// none
// Expected normal failure:
// none
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

var lo: Int = (-9007199254740991)
print[Int](lo)
print[Int](neg[Int](lo))
var low: Int64 = (-9223372036854775807i64)
print[Int64](low)
print[Int64](neg[Int64](low))
print[Int64](001i64)

print[Bool](eq[Int64](low,neg[Int64](low)))
print[Bool](lt[Int64](low,neg[Int64](low)))

// cmp[T](a,b)の時、 a < b => Right
print[Ordering](cmp[Int64](low,neg[Int64](low)))

// cmp[T](a,b)の時、 a = b => Flat
print[Ordering](cmp[Int](1,1))

// cmp[T](a,b)の時、 a > b => Left
print[Ordering](cmp[Float](2.0,1.0))

// balance[T](a,b)の時、 a < b => Right
print[Ordering](balance[Int](1,2))

// balance[T](a,b)の時、 a = b => Flat
print[Ordering](balance[Int](1,1))

// balance[T](a,b)の時、 a > b => Left
print[Ordering](balance[Int](2,1))

// slope[T](a,b)の時、 a < b => Rising
print[Slope](slope[Int](1,2))

// slope[T](a,b)の時、 a = b => Flat
print[Slope](slope[Int](1,1))

// slope[T](a,b)の時、 a > b => Falling
print[Slope](slope[Int](2,1))

// Float有限精度範囲外のため、true
print[Bool](eq[Float](0.99999999999999999, 1.0))

// Floatの有限精度範囲内のため、false
print[Bool](eq[Float](0.9999999999999999, 1.0))