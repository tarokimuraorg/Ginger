// Purpose:
// generic capability dispatch: Negatable / Printable
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_call_inference.py::test_print_without_expected_type
// tests/test_generic_guarantees.py::test_negatable_capability_and_unary_sugar
// tests/test_generic_guarantees.py::test_printable_capability_in_generic_unit_body
// Expected stdout (ordered):
// -1
// -1.0
// -1
// true
// Expected warnings (static diagnostic count; braces are one diagnostic):
// none
// Expected normal failure:
// none
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

sig opposite(T) -> T { require T guarantees Negatable }
func opposite(x: T) { return (-x) }
sig show(T) -> Unit { require T guarantees Printable }
func show(x: T) { print(x) }
show(opposite(1))
show(opposite(1.0))
show(opposite(1i64))
show(eq(1,1))
