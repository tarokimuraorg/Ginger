// Purpose:
// parameterized capability identity は latent failure と独立
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_concrete_identity_positions.py::test_concrete_and_open_world_targets_remain_valid
// tests/test_parameterized_type_identity.py::test_distinct_registers_allowed_but_exact_duplicate_rejected
// tests/test_parameterized_type_identity.py::test_parser_and_lowering_preserve_targets
// tests/test_parameterized_type_identity.py::test_register_isolation
// tests/test_parameterized_type_identity.py::test_thunk_result_identity_and_existing_effect_independence
// Expected stdout (ordered):
// 1
// 3
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {IntegerOverflow} x 1
// Expected normal failure:
// none
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

guarantee Mark {}
register Mark { Thunk[Int]<Never> }
typegroup IntThunks = Thunk[Int]<Never>

sig keep(T) -> T { 
    require T guarantees Mark
    require T in IntThunks
}

func keep(x: T) { return x }

print(force(keep(thunk(1))))
print(force(keep(thunk(add(1,2)))))

register Mark { Box[Int] }
register Mark { Box[Float] }

typegroup Boxes = Box[Box[Int]] | Pair[Int,Float] | MissingType
