// Purpose:
// 回復しない handler と handler の再 failure
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_resolve.py::test_handler_completion_without_target_recovery_keeps_event_unresolved
// tests/test_resolve.py::test_handler_presence_removes_warning_even_without_runtime_recovery
// tests/test_resolve.py::test_handler_same_failure_does_not_rerun_resolve
// tests/test_resolve.py::test_same_handler_failure_remains_unhandled
// Expected stdout (ordered):
// 2
// 3
// 4
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {FloatOverflow} x 2
// UNHANDLED_FAILURES {DivideByZero, FloatOverflow} x 1
// Expected normal failure:
// DivideByZero: unresolved x 3
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

var x: Float = div(1.0, 0.0)
resolve x {
    DivideByZero {
        print(2)
    }
}
print(3)

// handler の代入も失敗すると、元の event と新しい event は unresolved のまま。
var y: Float = div(1.0, 0.0)
resolve y {
    DivideByZero {
        y = div(2.0, 0.0)
    }
}
print(4)
