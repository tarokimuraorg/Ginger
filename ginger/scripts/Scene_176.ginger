// Only latest event recovers. Expected: 888; one older unresolved IntegerOverflow.
sig f(Int) -> Int { failure IntegerOverflow }
func f(x: Int) {
    var y: Int = 123
    y = add(x, 1)
    y = add(x, 2)
    resolve y {
        IntegerOverflow { y = 888 }
    }
    return y
}
print(f(9007199254740991))
