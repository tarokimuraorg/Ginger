// Purpose:
// 公開ソースから builtin を割り当てる impl 宣言を書くと構文エラーになる。
// Box[Int] の実装が Box[Float] に適用されないことは、下記の内部 AST テストで検証する。
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_parameterized_type_identity.py::test_specialized_impl_rejects_other_types_direct_and_deferred
// Expected stdout (ordered):
// (empty)
// Expected warnings (static diagnostic count; braces are one diagnostic):
// none
// Expected normal failure:
// none
// Expected fatal:
// SyntaxError
// builtin is internal to the Ginger implementation
// Expected completion: stops at SyntaxError
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.
// The public API raises this expected exception; subsequent source is not executed.

type Box[T]
guarantee G { op(self: Self) -> Self }
impl Box[Int] guarantees G { op = builtin core.int.neg }
sig op[T](T) -> T { require T guarantees G }
sig invalid(Box[Float]) -> Box[Float] {}
func invalid(x: Box[Float]) { return op[Box[Float]](x) }
