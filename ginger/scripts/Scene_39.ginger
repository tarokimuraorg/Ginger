// Purpose:
// 実引数は左から右、NoValue で残りと callee を実行しない
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_builtin_bridge.py::test_argument_failure_has_inner_origin_only
// tests/test_statement_continuation.py::test_arguments_left_to_right_stop_before_third_and_callee
// tests/test_statement_continuation.py::test_nested_builtin_not_called
// Expected stdout (ordered):
// 1
// 4
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {DivideByZero, FloatOverflow} x 1
// Expected normal failure:
// DivideByZero: unresolved x 1
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

sig mark(Int) -> Float {}
func mark(x: Int) { print(x) return toFloat(x) }
sig combine(Float,Float,Float) -> Float {}
func combine(a: Float,b: Float,c: Float) { print(99) return a }
print(combine(mark(1),div(1.0,0.0),mark(3)))
print(4)
