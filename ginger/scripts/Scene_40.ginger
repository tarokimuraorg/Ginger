// Purpose:
// 正常値の resolve は pending failure があっても no-op / Unit 回復
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_resolve.py::test_initialized_unit_value_with_pending_failure_is_no_op
// tests/test_resolve.py::test_successful_function_result_with_pending_failure_is_no_op
// tests/test_resolve.py::test_unit_recovery_counts_as_valid_binding
// Expected stdout (ordered):
// 3
// 2
// 4
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {FloatOverflow} x 2
// Expected normal failure:
// IntegerOverflow: unresolved x 1
// DivideByZero: unresolved x 1
// DivideByZero: resolved x 1
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

sig value() -> Int { failure IntegerOverflow }
func value() { print(add(9007199254740991,1)) return 3 }
var x: Int = value()
resolve x { IntegerOverflow { x = 0 print(999) } }
print(x)
sig unit() -> Unit { failure DivideByZero failure FloatOverflow }
func unit() { print(div(1.0,0.0)) }
var u: Unit = unit()
resolve u { DivideByZero { u = print(999) } }
var recover: Unit = print(div(1.0,0.0))
resolve recover { DivideByZero { recover = print(2) } }
print(4)
