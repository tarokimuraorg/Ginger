// Purpose:
// 未初期化 binding を次の initializer が読む fatal
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_uninitialized_reads.py::test_dependent_binding_and_chain_are_not_created
// Expected stdout (ordered):
// (empty)
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {DivideByZero, FloatOverflow} x 1
// UNHANDLED_FAILURES {FloatOverflow} x 1
// Expected normal failure:
// DivideByZero: unresolved x 1 before fatal (no ExecutionResult is returned)
// Expected fatal:
// EvalError
// cannot read uninitialized binding 'a'
// Expected completion: stops at EvalError
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.
// The public API raises this expected exception; subsequent source is not executed.

var a: Float = div(1.0, 0.0)
var b: Float = add(a,1.0)
print(999)
