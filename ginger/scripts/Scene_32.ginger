// builtinは処理系内部専用
//guarantee Opposite { flip(self: Self) -> Self } 
//impl Int guarantees Opposite { flip = builtin core.int.neg }
//impl Float guarantees Opposite { flip = builtin core.float.neg }

sig flip[T](T) -> T { require T guarantees Negatable }

func flip(a: T) {
    return -a
}

print[Int](flip[Int](2))
print[Float](flip[Float](2.5))

sig relay[U](U) -> U { require U guarantees Negatable }
func relay(x: U) { return neg[U](x) }

print[Int](relay[Int](3))
print[Float](relay[Float](3.5))

print[Int](add[Int](1,2))
