// builtinは処理系内部専用
//guarantee Opposite { flip(self: Self) -> Self } 
//impl Int guarantees Opposite { flip = builtin core.int.neg }
//impl Float guarantees Opposite { flip = builtin core.float.neg }

sig flip(T) -> T { require T guarantees Negatable }

func flip(a: T) {
    return -a
}

print(flip(2))
print(flip(2.5))

sig relay(U) -> U { require U guarantees Negatable }
func relay(x: U) { return neg(x) }

print(relay(3))
print(relay(3.5))

print(add(1,2))
