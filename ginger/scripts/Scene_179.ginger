// Symmetric integer limits: comparisons do not subtract operands.
print[Ordering](balance[Int](9007199254740991, (-9007199254740991)))
print[Slope](slope[Int]((-9007199254740991), 9007199254740991))
print[Bool](gt[Int](9007199254740991, (-9007199254740991)))

print[Ordering](balance[Int64](9223372036854775807i64, (-9223372036854775807i64)))
print[Slope](slope[Int64]((-9223372036854775807i64), 9223372036854775807i64))
print[Bool](gt[Int64](9223372036854775807i64, (-9223372036854775807i64)))

// Finite Float extremes and equal signed zeros.
print[Ordering](balance[Float](1e308, (-1e308)))
print[Slope](slope[Float]((-1e308), 1e308))
print[Bool](gt[Float](1e308, (-1e308)))
print[Ordering](balance[Float]((-0.0), 0.0))
print[Slope](slope[Float]((-0.0), 0.0))
print[Bool](eq[Float]((-0.0), 0.0))
print[Bool](lt[Float]((-0.0), 0.0))
print[Bool](gt[Float]((-0.0), 0.0))
