// Symmetric integer limits: comparisons do not subtract operands.
print(balance(9007199254740991, (-9007199254740991)))
print(slope((-9007199254740991), 9007199254740991))
print(gt(9007199254740991, (-9007199254740991)))

print(balance(9223372036854775807i64, (-9223372036854775807i64)))
print(slope((-9223372036854775807i64), 9223372036854775807i64))
print(gt(9223372036854775807i64, (-9223372036854775807i64)))

// Finite Float extremes and equal signed zeros.
print(balance(1e308, (-1e308)))
print(slope((-1e308), 1e308))
print(gt(1e308, (-1e308)))
print(balance((-0.0), 0.0))
print(slope((-0.0), 0.0))
print(eq((-0.0), 0.0))
print(lt((-0.0), 0.0))
print(gt((-0.0), 0.0))
