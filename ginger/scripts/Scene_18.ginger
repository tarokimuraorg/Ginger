// Purpose:
// resolve no-op・再試行・同種 failure の対象分離
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_resolve.py::test_initialized_binding_does_not_process_other_events
// tests/test_resolve.py::test_initialized_binding_is_no_op
// tests/test_resolve.py::test_other_binding_with_same_failure_is_not_resolved
// tests/test_resolve.py::test_parser_uses_target_and_existing_statement_blocks
// Expected stdout (ordered):
// 3
// 0
// 999
// 0
// 0
// 999
// Expected warnings (static diagnostic count; braces are one diagnostic):
// none
// Expected normal failure:
// IntegerOverflow: resolved x 3
// IntegerOverflow: unresolved x 1
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

// 1. 正常時はresolveが何もしない
var a: Int = add(1, 2)

resolve a {
    IntegerOverflow {
        a = 0
    }
}

print(a)

// 2. 本当に回復する
var b: Int = mul(9007199254740991, 2)

resolve b {
    IntegerOverflow {
        b = 0
    }
}

print(b)

// 3. handlerが値を直さなければ未解決のまま
var c: Int = mul(9007199254740991, 2)

resolve c {
    IntegerOverflow {
        print(999)
    }
}

resolve c {
    IntegerOverflow {
        c = 0
    }
}

//print(b)
print(c)

// 4. 同種failureを取り違えない
var x: Int = mul(9007199254740991, 2)
var y: Int = mul(9007199254740991, 2)

resolve x {
    IntegerOverflow {
        x = 0
    }
}

print(x)

resolve y {
    IntegerOverflow {
        x = 999
    }
}

print(x)

//print(y)
