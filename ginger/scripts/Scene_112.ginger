// Purpose:
// 無条件 failure と同じ条件付き failure の冗長併記を拒否
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_conditional_failures.py::test_unconditional_and_conditional_redundancy_rejected_in_both_orders
// Expected stdout (ordered):
// (empty)
// Expected warnings (static diagnostic count; braces are one diagnostic):
// none
// Expected normal failure:
// none
// Expected fatal:
// SyntaxError
// redundant conditional failure 'IntegerOverflow'
// Expected completion: stops at SyntaxError
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.
// The public API raises this expected exception; subsequent source is not executed.

sig f(T) -> T { failure IntegerOverflow failure IntegerOverflow when T guarantees BoundedArithmetic }
