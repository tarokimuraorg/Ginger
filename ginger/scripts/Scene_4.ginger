// Purpose:
// Thunk snapshot・再代入・latent failure
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_call_inference.py::test_thunk_latent_effect_uses_selected_implementation
// tests/test_failure_contract.py::test_samples_outputs_and_warnings
// tests/test_function_locals.py::test_local_thunk_latent_failure_and_function_contract
// tests/test_integer_overflow.py::test_thunk_creation_latent_force_and_failureset
// tests/test_runtime_immutability.py::test_reassignment_replaces_cell_and_preserves_capture
// tests/test_unary_minus.py::test_all_sample_baselines
// Expected stdout (ordered):
// 1
// 2
// 123
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {IntegerOverflow} x 2
// Expected normal failure:
// IntegerOverflow: unresolved x 1
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

var x: Int = 1
var t1: Thunk[Int]<IntegerOverflow> = thunk(x)
x = 2
print(force(t1))
print(x)

// t1 は IntegerOverflow を発生させる
t1 = thunk(add(9007199254740991, 1))
print(123)

// 警告：Unresolved failure: IntegerOverflow; event: #1; origin: core.int.add; call: 1（t1 は IntegerOverflow を発生させる）
print(force(t1))

// エラー：Thunk の latent failure は force した結果の binding で解決する
//resolve t1 {
//    IntegerOverflow {
//        t1 = thunk(999)
//    }
//}

// エラー：ginger.errors.TypecheckError: Thunk requires a result type and explicit failure contract
//var t2: Thunk[Int] = thunk(10)
