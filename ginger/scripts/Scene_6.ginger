failureset CalculationFailure {
    DivideByZero
    IOErr
}

var t1: Thunk[Float, CalculationFailure] = thunk(div(1.0,0.0))

var first: Float = force(t1)
resolve first {
    DivideByZero {
        first = 0
    }
    IOErr {
        first = 1
    }
}

print(first)

var t2: Thunk[Float, DivideByZero] = thunk(div(10.0,2.0))

var second: Float = force(t2)
resolve second {
    DivideByZero {
        second = 0
    }
}

print(second)