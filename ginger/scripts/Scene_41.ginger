// Purpose:
// resolve は failed return/argument の直接原因だけを回復
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_resolve.py::test_failed_argument_cause_excludes_successful_argument_pending_events
// tests/test_resolve.py::test_failed_return_cause_excludes_earlier_failed_statement
// Expected stdout (ordered):
// 0.0
// 0
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {FloatOverflow} x 2
// Expected normal failure:
// IntegerOverflow: unresolved x 1
// DivideByZero: resolved x 1
// DivideByZero: unresolved x 1
// IntegerOverflow: resolved x 1
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

sig failed() -> Float { failure IntegerOverflow failure DivideByZero failure FloatOverflow }
func failed() { print(add(9007199254740991,1)) return div(1.0,0.0) }
var x: Float = failed()
resolve x { IntegerOverflow { print(999) x = 9 } DivideByZero { x = 0 } }
print(x)
sig value() -> Int { failure DivideByZero failure FloatOverflow }
func value() { print(div(1.0,0.0)) return 3 }
var y: Int = add(value(),add(9007199254740991,1))
resolve y { DivideByZero { print(999) y = 9 } IntegerOverflow { y = 0 } }
print(y)
