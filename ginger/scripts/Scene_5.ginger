failureset CalculationFailure {
    DivideByZero
    IOErr
}

sig calculate() -> Float {
    failure CalculationFailure
}

func calculate() {
    return div(1.0, 0.0)
}

var result: Float = calculate()
resolve result {
    DivideByZero {
        result = 0
        print(0)
    }
    IOErr {
        result = 1
        print(1)
    }
}
