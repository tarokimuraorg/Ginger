// Purpose:
// user function は guarantee method projection の対象外
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_guarantee_method_arity.py::test_user_function_is_not_guarantee_dispatch
// tests/test_guarantee_method_signature.py::test_user_function_and_direct_builtin_are_exempt
// Expected stdout (ordered):
// 1
// Expected warnings (static diagnostic count; braces are one diagnostic):
// none
// Expected normal failure:
// none
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

guarantee G { op(self: Self, other: Self) -> Float }
impl Int guarantees G { op = builtin core.int.add }
sig op(T) -> T { require T guarantees G }
func op(x: T) { return x }
print(op(1))
