// Purpose:
// 失敗した関数ローカル initializer の read は fatal
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_function_locals.py::test_failed_initializer_and_assignment_preserve_environment
// Expected stdout (ordered):
// (empty)
// Expected warnings (static diagnostic count; braces are one diagnostic):
// none
// Expected normal failure:
// IntegerOverflow: unresolved x 1 before fatal (no ExecutionResult is returned)
// Expected fatal:
// EvalError
// cannot read uninitialized binding 'y'
// Expected completion: stops at EvalError
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.
// The public API raises this expected exception; subsequent source is not executed.

sig f(Int) -> Int {
    failure IntegerOverflow
}

func f(x: Int) {
    var y: Int = add(x, 1)

    resolve y {
        IntegerOverflow {
            y = 888
        }
    }

    return y
}

var result: Int = f(1)
print(result)

result = f(9007199254740991)

// f 内で IntegerOverflow が解決済みの為、以下の resolve による値の更新はない
resolve result {
    IntegerOverflow {
        result = 999
    }
}

print(result)
