// Purpose:
// 具体型ごとの Thunk と条件付き FailureSet の伝播
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_conditional_failures.py::test_generic_force_thunk_preserves_symbolic_and_runtime_contracts
// tests/test_conditional_failures.py::test_nested_generic_condition_substitutes_u_to_t
// tests/test_float_finite.py::test_nested_generic_thunk_overflow_keeps_concrete_frame_contracts
// tests/test_function_locals.py::test_local_thunk_latent_failure_and_function_contract
// tests/test_generic_guarantees.py::test_nested_generic_substitution_and_frame_bindings
// tests/test_generic_guarantees.py::test_thunk_captures_generic_dispatch_binding
// tests/test_thunk_contract.py::test_functions_and_transitive_validation
// Expected stdout (ordered):
// 3
// 3.0
// 7
// 8.0
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {FloatOverflow, FloatUnderflow, IntegerOverflow} x 2
// Expected normal failure:
// IntegerOverflow: resolved x 1
// FloatOverflow: resolved x 1
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

failureset AddFailures(T) {
    IntegerOverflow when T in BoundedArithmetic,
    FloatOverflow when T in FiniteArithmetic,
    FloatUnderflow when T in FiniteArithmetic
}

sigtype DeferredInt() -> Int { failure { AddFailures(Int) } }
sig delayedInt(Int,Int) -> Thunk[DeferredInt] {}

func delayedInt(a: Int,b: Int) {
    return thunk(a + b)
}

sig innerInt(Int,Int) -> Int {
    failure {
        AddFailures(Int)
    }
}

func innerInt(a:Int, b:Int) {
    return force(delayedInt(a,b))
}

sig outerInt(Int,Int) -> Int {
    failure {
        AddFailures(Int)
    }
}

func outerInt(a: Int,b: Int) {
    return innerInt(a,b)
}

sigtype DeferredFloat() -> Float { failure { AddFailures(Float) } }
sig delayedFloat(Float,Float) -> Thunk[DeferredFloat] {}

func delayedFloat(a: Float,b: Float) {
    return thunk(a + b)
}

sig innerFloat(Float,Float) -> Float {
    failure {
        AddFailures(Float)
    }
}

func innerFloat(a:Float, b:Float) {
    return force(delayedFloat(a,b))
}

sig outerFloat(Float,Float) -> Float {
    failure {
        AddFailures(Float)
    }
}

func outerFloat(a: Float,b: Float) {
    return innerFloat(a,b)
}

print(force(delayedInt(1,2)))
print(force(delayedFloat(1.0,2.0)))
print(outerInt(6,4))
print(outerFloat(2.5,7.4))
var i: Int = outerInt(9007199254740991,1)

resolve i {
    IntegerOverflow {
        i = 7
    }
}

var f: Float = outerFloat(.0,.0)

resolve f {
    FloatOverflow {
        f = 8
    }
}

print(i)
print(f)