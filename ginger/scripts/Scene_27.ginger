// Purpose:
// Float finite 境界・signed zero・subnormal・underflow・rounding
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_float_finite.py::test_finite_literals_include_max_subnormal_and_signed_zero
// tests/test_float_finite.py::test_nan_inf_remain_identifiers_not_literals
// tests/test_float_finite.py::test_neg_and_int_conversions_have_empty_contracts
// tests/test_float_finite.py::test_underflow_and_rounding_are_valid
// Expected stdout (ordered):
// 1.7976931348623157e+308
// -1.7976931348623157e+308
// 5e-324
// 0.0
// -0.0
// 0.0
// -0.0
// 0.30000000000000004
// 1.0
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {FloatOverflow} x 3
// Expected normal failure:
// none
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

print(.0)
print(neg(.0))
print(0.)
print(0.0)
print((-0.0))
print(mul(0.,0.5))
print(mul((-0.),0.5))
print(add(0.1,0.2))
var nan: Float = 1.0
print(nan)
