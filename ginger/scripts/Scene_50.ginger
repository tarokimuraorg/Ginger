// Purpose:
// failureset forward reference・overlap・別 namespace と attr.io
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_failure_contract.py::test_attributes_preserved_and_invalid_placements_rejected
// tests/test_failure_contract.py::test_builtin_contract_is_visible_and_resolvable
// tests/test_failureset.py::test_expansion_and_mixed_declarations
// tests/test_failureset.py::test_forward_reference_and_overlap
// tests/test_failureset.py::test_function_and_thunk_contract_equivalence
// tests/test_failureset.py::test_namespace_collisions
// Expected stdout (ordered):
// 1
// Expected warnings (static diagnostic count; braces are one diagnostic):
// UNHANDLED_FAILURES {DivideByZero, FloatOverflow, IOErr} x 1
// UNHANDLED_FAILURES {IOErr} x 1
// Expected normal failure:
// none
// Expected fatal:
// none
// Expected completion: normal; report_result returns 0
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.

@attr.io
sig notify() -> Unit { failure A failure B failure IOErr }
@attr.io
func notify() { print(1) }
failureset A { IOErr }
failureset B { IOErr DivideByZero FloatOverflow }
guarantee Shared {}
typegroup Shared = Int
failureset Shared { IOErr }
sig Shared() -> Unit { failure Shared }
func Shared() {}
notify()
Shared()
