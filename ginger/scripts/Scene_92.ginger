// Purpose:
// 複数 guarantee 要求だけでは method dispatch を選択しない
// Based on tests (source-visible behavior; host/internal assertions remain unit tests):
// tests/test_guarantee_method_arity.py::test_multiple_guarantee_requirements_are_not_arity_validated
// Expected stdout (ordered):
// (empty)
// Expected warnings (static diagnostic count; braces are one diagnostic):
// none
// Expected normal failure:
// none
// Expected fatal:
// SyntaxError
// builtin is internal to the Ginger implementation
// Expected completion: stops at SyntaxError
// Run with the README pipeline.run API; main.report_result displays unresolved/fatal results.
// Trusted internal AST fixture: TypecheckError (no implementation); covered by the test above.
// The public API raises this expected exception; subsequent source is not executed.

guarantee G { op(self: Self, other: Self) -> Self }
impl Int guarantees G { op = builtin core.int.add }
guarantee H { witness(self: Self) -> Self }
impl Int guarantees H { witness = builtin core.int.neg }
sig op[T](T) -> T { require T guarantees G require T guarantees H }
print[Int64](op[Int](1))
